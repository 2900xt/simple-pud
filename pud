def main():
    print(f"{BOLD}PUD - Poker Screen Parser{R}")
    print(f"{DIM}Capture -> OCR Parse -> Game State{R}\n")

    if "--help" in sys.argv or "-h" in sys.argv:
        print_help()
        return

    if "--setup" in sys.argv:
        check_deps()
        idx = sys.argv.index("--setup")
        setup_args = sys.argv[idx + 1:]
        setup_targeted(setup_args)
        return

    from screen_parser import load_config
    config = load_config()
    if not config:
        print(f"No config found. Run: {BOLD}./pud --setup{R}")
        sys.exit(1)

    check_deps()

    # Load hotkey from .env (optional)
    hotkey = "F12"
    env_path = os.path.join(PROJECT_ROOT, ".env")
    if os.path.exists(env_path):
        with open(env_path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("HOTKEY="):
                    hotkey = line.split("=", 1)[1].strip()

    run_hotkey_loop(config, hotkey)


if __name__ == "__main__":
    main()
